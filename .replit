# XPuesto en Replit: sitio estático. Importar desde GitHub y darle Deploy → Static.
run = "npm run dev -- --host 0.0.0.0 --port 5180"
entrypoint = "index.html"
modules = ["nodejs-22"]

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["npm", "run", "build"]

[[ports]]
localPort = 5180
externalPort = 80
